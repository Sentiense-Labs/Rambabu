{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "docs/PROJECT_PHILOSOPHY.md",
    "docs/ENGINEERING_GUIDELINES.md",
    "docs/DECISIONS.md"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "uv sync": "allow",
      "uv run *": "allow",
      "uv add *": "ask",
      "journalctl *": "allow",
      "sudo journalctl *": "allow",
      "git *": "ask",
      "python3 main.py": "ask"
    }
  },
  "formatter": {
    "black": {
      "command": ["uv", "run", "black", "$FILE"],
      "extensions": [".py"]
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  }
}
